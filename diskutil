media_volume_resize(){
    # resizes a partition and filesystem

    if [[ -z $1 ]]; then
        echo "Usage: disutil resize volume [min max size] [-y] [-v]"
        echo "  example diskutil resizeVolume sda1 min"
        echo "  does not work on exfat or hfs filesystems."
        return
    fi

    local DEVICE=$(media_device_name $1)
    local PART_NUM=$(media_device_partnum $1)
    local PARTITION=$(media_device_fullname $1)
    local SIZE=${2:-max}

    local FS_TYPE=$(media_partition_fs_type $PARTITION)
    local ORIGIONAL_SIZE=$(media_filesystem_size $PARTITION $FS_TYPE)

    #local FS_SIZE
    local NEWSIZE

    local YESNO
    local VERBOSE
    local FORCE
    getargs $*

    ui_msg "RESIZE" "=====================================================================" white
    ui_msg "RESIZE" "Resize Volume $PARTITION from $(bytes $ORIGIONAL_SIZE -h) to $SIZE..." white


    media_device_checktarget $PARTITION part
    if (( $? )); then return 1; fi


    ui_msg "RESIZE" "Calibrating..."

    local PART_MAX=$(media_partition_max $PARTITION)
    local WAS_MOUNTED=$(media_filesystem_ismounted $PARTITION)
    local FS_MIN=$(media_filesystem_min $PARTITION $FS_TYPE)


#echo_debug $LINENO

    case $SIZE in
        min)    NEW_SIZE=min
                NEW_SIZE_H=$(bytes $(media_filesystem_min $PARTITION $FS_TYPE) -h )
                ;;

        max)
                NEW_SIZE=$(( $PART_MAX - $(media_partition_start $PARTITION) ))
                NEW_SIZE_H=$(bytes $NEW_SIZE -h)
          #      echo_debug $LINENO max=$(media_partition_max $PARTITION) start=$(media_partition_start $PARTITION)
          #      echo_debug $LINENO $NEW_SIZE $NEW_SIZE_H
                ;;

        *)      NEW_SIZE=$(bytes $SIZE -b)
                NEW_SIZE_H=$(bytes $NEW_SIZE -h)
                ;;
    esac

#echo_debug $LINENO new=$NEW_SIZE fs=$FS_MIN


   case $FS_TYPE in
        exfat)
            ui_msg RESIZE "Cannot resize exfat filesystems.  Use Windows." red
            return 1
            ;;
        hfs*)
            ui_msg RESIZE "Cannot resize hfs or hfsplus filesystems.  Use MAC OS." red
            return 1
            ;;
        xfs)
            if [[ $NEW_SIZE -lt $ORIGIONAL_SIZE ]]; then
                ui_msg RESIZE "Cannot shrink xfs filesystems. " red
                return 1
            fi
            ;;
    esac


    # Check sizes...
    if [[ $NEW_SIZE -lt $FS_MIN ]]; then
        ui_msg "RESIZE" "Minimum is $(bytes $FS_MIN -h)  New_size=$NEW_SIZE"
     #   return 1
    fi

    if [[ $NEW_SIZE -gt $PART_MAX ]]; then
        ui_msg "RESIZE" "Max is $(bytes $PART_MAX -h) New_size=$NEW_SIZE"
       # return 1
    fi

    if  (( ! $(ui_yesno "RESIZE" "Resize '$PARTITION' ($FS_TYPE) from '$(bytes $ORIGIONAL_SIZE -h)' to about '$NEW_SIZE_H' ($NEW_SIZE)" $YESNO) )); then
        echo Resize canceled.
        return 1
    fi

    # unmount
    media_volume_unmount $PARTITION -y $VERBOSE
    if (( $? )); then return 1; fi

    # repair
    ui_msg "RESIZE" "Repairing filesystem before resize..." white
    media_filesystem_repair $PARTITION $FS_TYPE -y $VERBOSE
    if (( $? )); then
        ui_msg_error $LINENO "Error running filesystem repair.  Cannot resize."
        if [[ $FORCE = -f ]]; then
            ui_countdown 10
        else
            echo exiting ...
            return 1
        fi
    fi

#echo_debug $LINENO new=$NEW_SIZE  $(( $NEW_SIZE / 1024 / 1024 )) M

    # quit if still mounted
    if [[ $(media_filesystem_ismounted $PARTITION) = 1 ]]; then
        echo $PARTITION is mounted. Cannot continue.
        return 1
    fi


    case $FS_TYPE in
        fat16|fat32|vfat)
            # dont need to resize the partition, just the filesystem
            echo
       #     ui_msg "RESIZE" "Resize the FILESYSTEM to $NEW_SIZE_H..." white
            media_filesystem_resize $PARTITION $NEW_SIZE $FS_TYPE -y $VERBOSE
            if (( $? )); then return 1; fi
            ;;

        *)
            # shrink
            if [[ $NEW_SIZE -lt $ORIGIONAL_SIZE ]]; then
                echo_green Shrink...
                echo
         #       ui_msg "RESIZE" "Shrink the FILESYSTEM to $NEW_SIZE_H..." white
                media_filesystem_resize $PARTITION $NEW_SIZE $FS_TYPE -y $VERBOSE
                if (( $? )); then return 1; fi

                sleep 1
                echo
         #       ui_msg "RESIZE" "Shrink PARTITION to fit FILESYSTEM..." white
                media_partition_resize $PARTITION min $FS_TYPE -y $VERBOSE
                if (( $? )); then return 1; fi
            fi

            # grow
            if [[ $NEW_SIZE -gt $ORIGIONAL_SIZE ]]; then
                echo_green Grow...
                echo
         #       ui_msg "RESIZE" "Grow the PARTTITION to $NEW_SIZE_H... "
                media_partition_resize $PARTITION $NEW_SIZE $FS_TYPE -y $VERBOSE
                if (( $? )); then return 1; fi

                sleep 1
                echo
         #       ui_msg "RESIZE" "Grow FILESYSTEM to fit PARTITION..."
                #media_filesystem_resize_topart $PARTITION
              #  media_filesystem_resize $PARTITION $NEW_SIZE $YESNO $VERBOSE
                media_filesystem_resize $PARTITION max $FS_TYPE -y $VERBOSE
                if (( $? )); then return 1; fi
            fi
            ;;
    esac

    sleep .5
    echo
    ui_msg "RESIZE"  "Checking filesytem on $PARTITION after resize..." white
    media_filesystem_check $PARTITION $FS_TYPE $YESNO $VERBOSE
    if (( $? )); then
        ui_msg_error $LINENO "Errors on filesystem $PARTITION after resizing."
        return 1
    fi

    echo
    ui_msg "RESIZE" "Volume '$PARTITION' resized from '$(bytes $ORIGIONAL_SIZE -h)' to '$(bytes $(media_partition_size $PARTITION) -h )'" green
}


getargs(){
    #sets the local variables of the calling function

    local ARGS=$*

#echo_debug "args=$ARGS"

    for ARG in $ARGS; do
#echo_debug "$LINENO testing arg '$ARG'"
        case $ARG in
            -y|--yes)           YESNO=-y    ;;
            -v|--verbose)       VERBOSE=-v  ;;
     #       -q)                 QUIET=-q    ;;
            -f|--force)         FORCE=-f    ;;
            -n)                 RW=-n       ;;    # for badblocks
            *)
                if [[ "$FILESYSTEMS" = *"$ARG"* ]]; then
                    FS_TYPE=$ARG
                fi

        esac
    done
}


