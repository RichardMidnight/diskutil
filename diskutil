    if [[ -z $1 ]]; then
        echo "Usage: diskutil umountDisk device [-y]"
        echo "Unmounts all the directly-mountable volumes on the disk."
        return
    fi

    DISK=$(media_device_name $1)

    local YESNO
    local VERBOSE
    local FORCE
    getargs $*

    media_device_checktarget $DISK disk
    if (( $? )); then exit 1; fi

    (( $(ui_yesno "UNMOUNT" "unmount all volumes on $DISK" $YESNO) )) || return

    local MOUNTS_LIST=$(df --output=source | grep $DISK)
#echo_debug $LINENO Partitions to unmount: $MOUNTS_LIST

    if [[ ! -z $MOUNTS_LIST ]]; then
        run_command "sudo umount $FORCE $MOUNTS_LIST" $LINENO $VERBOSE
        #return
    fi
    return

    PARTITION_COUNT=$(media_disk_partcount $DISK)

    # if no partitions...
    if ! (( $PARTITION_COUNT )); then
        media_volume_unmount $DISK -y $VERBOSE
        return
    fi

   run_command "sudo umount $DISK* -q $FORCE" $LINENO $VERBOSE
   if (( $? )); then return 1; fi

    }


