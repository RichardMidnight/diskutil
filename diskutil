media_filesystem_uninstall(){
    # removes support for a filesystem

    if [[ -z $1 ]]; then
        echo "Usage: diskutil uninstallFS [filesystem] [-y]"
        echo "Supported filesystems are: [$FILESYSTEMS]"
        echo "'all' is not allowed with uninstallFS"
        return 1
    fi

    local PACKAGES
    case $1 in
        fat16|fat32|vfat)    PACKAGES="dosfstools mtools fatresize" ;;
        exfat)               PACKAGES="exfatprogs" ;;
        ntfs)                PACKAGES="ntfs-3g fuse" ;;
        ext2|ext3|ext4)      PACKAGES="e2fsprogs" ;;
        hfs+|hfsplus)        PACKAGES="hfsprogs" ;;
        hfs)                 PACKAGES="hfsprogs" ;;
        xfs)                 PACKAGES="xfsprogs xfsdump" ;;
        btrfs)               PACKAGES="btrfs-progs" ;;
        cifs)                PACKAGES="cifs-utils" ;;
        linux-swap|freespace)
            # swap/freespace are core OS facilities in util-linux; nothing to remove
            ui_msg_warning $LINENO "$1 support is a core OS facility (util-linux); cannot be removed."
            return 1
            ;;
        *)
            ui_msg_warning $LINENO "Unknown filesystem '$1'. Nothing to remove."
            return 1
            ;;
    esac

    local FS_TYPE=$1
    local REMOVE=$(env_removal)
    if [[ -z $REMOVE ]]; then
        return 1
    fi

    local YESNO
    local VERBOSE
    getargs $*

    if (( ! $(ui_yesno "UNINSTALL FS" "Remove support for $FS_TYPE: $PACKAGES" $YESNO) )); then
        echo "Uninstall canceled"
        return
    fi

    # refuse to remove a package the system still needs
    local PKG
    local BLOCKED=""
    for PKG in $PACKAGES; do
        if env_package_in_use $PKG; then
            BLOCKED="$BLOCKED $PKG"
        fi
    done

    if [[ -n $BLOCKED ]]; then
        ui_msg_error $LINENO "Cannot remove: the system requires:$BLOCKED"
        return 1
    fi

    for PKG in $PACKAGES; do
        echo_white Removing $PKG ...
        run_command "sudo $REMOVE $PKG " $LINENO -v
    done
}


# ---------- Misc functions

do_beep(){
    local FREQ=${1:-600}
    local TIME=${2:-.5}

    if [[ $SOUND = on && $FREQ =~ ^-?[0-9]*\.?[0-9]+$ && $TIME =~ ^[0-9]*\.?[0-9]+$ ]] ; then
        (speaker-test -t sign -f "$FREQ" > /dev/null 2>&1 & sleep "$TIME" && kill "$!") > /dev/null
    fi
}


do_beep_up(){ do_beep 500 .3; do_beep 600 .4; }


do_beep_down(){ do_beep 600 .3; do_beep 500 .4; }


get_elapsed_time() {
    # parameters are in seconds
    local BEG=$1
    local END=$2

    echo $(( ($END-$BEG)/60 )) min $(( ($END-$BEG)%60 )) sec
}


do_countdown(){
    local MAX=${1:-10}
    local MSG=${2:-"Pausing for $MAX seconds... Press y to continue immediately or any other key to stop"}
    local INPUT

    echo "$MSG"
    echo -n "$MAX"
    sleep 1
    for number in $(seq 1 $MAX) ; do
        echo -n ".$(($MAX-$number))"
        read -s -t 1 -N 1 INPUT
        if [[ -n $INPUT ]]; then
            if [[ $INPUT = y ]]; then
                echo "Continuing..."
                return
            else
                echo " $INPUT Countdown stopped..."
                return 2
            fi
        fi
    done
    echo ...
}


