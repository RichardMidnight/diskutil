media_disk_info(){
    # displays info about a disk, modeled on macOS 'diskutil info disk0'

    if [[ -z $1 ]]; then
        echo "Usage: diskutil info[rmation] device"
        exit
    fi

    local DISK=$(media_device_name $1)
    local DEV=$(media_device_fullname $1)

    local YESNO
    local VERBOSE
    getargs $*

    local MODEL=$(media_disk_model $DISK)
    local SIZE=$(bytes $(lsblk -dnb -o SIZE $DEV) -h)
    local SECTOR=$(lsblk -dn -o LOG-SEC $DEV 2>/dev/null | xargs)
    [[ -z $SECTOR ]] && SECTOR=$(lsblk -dn -o LOG-SECTOR $DEV 2>/dev/null | xargs)
    local PT=$(lsblk -dn -o PTTYPE $DEV | xargs)
    local PARTS=$(media_disk_partcount $DISK)
    local TRANS=$(lsblk -dn -o TRAN $DEV 2>/dev/null | xargs)
    [[ -z $TRANS ]] && TRANS=$(lsblk -dn -o TRANSPORT $DEV 2>/dev/null | xargs)

    case $PT in
        gpt)        PT="GUID" ;;
        dos|msdos)  PT="MBR"  ;;
        "")         PT="(none)" ;;
    esac

    echo
    echo "$DEV"
    printf '%24s %s\n' "Device Node:" "$DEV"
    printf '%24s %s\n' "Whole:" "Yes"
    printf '%24s %s\n' "Model:" "$MODEL"
    printf '%24s %s\n' "Protocol:" "${TRANS:--}"
    printf '%24s %s\n' "Capacity:" "$SIZE"
    printf '%24s %s\n' "Sector Size:" "${SECTOR:--} B"
    printf '%24s %s\n' "Partition Map:" "$PT"
    printf '%24s %s\n' "Volumes:" "$PARTS"

    if [[ $VERBOSE = -v ]]; then
        echo
        echo_white "Detail"
        run_command "sudo parted $DEV print free" $LINENO -v
        run_command "lsblk -f $DEV" $LINENO -v
        run_command "lsblk -t $DEV" $LINENO -v
    fi
}


