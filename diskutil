media_volume_info(){
    # displays information about a partition/volume, modeled on macOS
    # 'diskutil info disk0s1' - read only, does not mount

    if [[ -z $1 ]]; then
        echo "Usage: diskutil info volume"
        return
    fi

    local PARTITION=$(media_device_fullname $1)
    local DISK=$(media_device_name $1)

    local YESNO
    local VERBOSE
    getargs $*

    local FSTYPE=$(lsblk -dn -o FSTYPE $PARTITION | xargs)
    local SIZE=$(bytes $(lsblk -dnb -o SIZE $PARTITION) -h)
    local USED=$(lsblk -dn -o FSUSED $PARTITION | xargs)
    local LABEL=$(lsblk -dn -o LABEL $PARTITION | xargs)
    local MOUNT=$(lsblk -dn -o MOUNTPOINT $PARTITION | xargs)
    local UUID=$(blkid -s UUID -o value $PARTITION 2>/dev/null)

    echo
    echo "$PARTITION"
    local FS=${FSTYPE:-<unformatted>}
    printf '%24s %s\n' "Device Node:" "$PARTITION"
    printf '%24s %s\n' "Whole:" "No"
    printf '%24s %s\n' "Part. of Whole:" "$DISK"
    printf '%24s %s\n' "Type:" "$FS"
    [[ -n $LABEL ]] && printf '%24s %s\n' "Filesystem Personality:" "$LABEL"
    [[ -n $UUID  ]] && printf '%24s %s\n' "UUID:" "${UUID}  (${FSTYPE})"
    local FSSIZE=$(lsblk -dn -o FSSIZE $PARTITION | xargs)
    [[ -n $FSSIZE ]] && printf '%24s %s\n' "Filesystem Size:" "$FSSIZE"
    [[ -n $USED  ]] && printf '%24s %s\n' "Percent Used:" "${USED}%"
    [[ -n $MOUNT ]] && printf '%24s %s\n' "Current Mount Point:" "$MOUNT"
    printf '%24s %s\n' "Volume Size:" "$SIZE"

    if [[ $VERBOSE = -v ]]; then
        echo
        echo_white "Detail"
        run_command "blkid $PARTITION" $LINENO -v
        run_command "lsblk -f $PARTITION" $LINENO -v
    fi
    return 0
}


