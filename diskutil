        case $MENU_CHOICE in
            BACKUP)         media_backup  ;;

            RESTORE)        media_restore ;;

            LIST)           echo "Getting list of images ready..."
                            ui_msg LIST "$(do_list_info $DEFAULT_PATH)"  ;;

            SETTINGS)       menu_settings    ;;

            TOOLS)          menu_tools       ;;

            HELP)           ui_msg HELP "$(pisafe_help)" ;;

            ABOUT)          ui_msg ABOUT "$(pisafe_about)"  ;;

            "  "*)          ;;

            * )             return       ;;
        esac
    done

}


