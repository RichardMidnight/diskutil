media_disk_model(){
    # returns a disk's vendor and model

    local DISK=$(media_device_name $1)
    local MODEL=$(lsblk $DISK -n -d -o vendor,model | sed 's/  */ /g')
    local MODEL_DEBLANKED=$(echo $MODEL | sed 's/ //g')
#echo_debug "$LINENO '$MODEL'"

    if [[ -z $MODEL_DEBLANKED ]]; then
#echo_debug $LINENO  $MODEL  $DISK
        MODEL=$(sudo parted $DISK print free | grep Model | cut -d: -f2 | cut -d'(' -f1 )
#echo_debug $LINENO  $MODEL
    fi
    echo "$MODEL"
}

media_disk_serial(){
    # Returns the serial number of the disk
    local DISK=$(media_device_name $1)

    lsblk $DISK -n -d -o vendor,model,serial | sed 's/  */ /g'
}


media_disk_sectorsize(){
    # returns the sector size of the disk.  usually 512
    local DISK=$(media_device_fullname $1)

    sudo blockdev --getss $DISK
}

media_disk_blocksize(){
    # returns the blocksize of the disk n bytes
    local DISK=$(media_device_fullname $1)
    # often 512 for flash drive, 4095 for mmc
    # or 2048 sectors sometimes???

    sudo blockdev --getbsz $DISK
}

media_real_disks(){
    # returns the names of real physical disks only
    # excludes loop, zram and other virtual devices
    lsblk -n -d -o name,TYPE 2>/dev/null | awk '$2 == "disk" && $1 !~ /^(zram|loop)/ {print $1}'
}


media_disk_listdisks(){
    # list of disks available to the system
    local DISK
    local DISKS=$(media_real_disks)
    #echo_debug $LINENO $DISKS
    local YESNO
    local VERBOSE
    getargs $*

    if [[ ! -z $VERBOSE ]]; then
        ui_msg "DISKS" " " white
    fi

    for DISK in $DISKS; do
        #echo_debug $LINENO $DISK
        echo $(media_disk_friendlyname $DISK)
        #echo_debug $LINENO $DISK
    done
}


media_disk_list(){
    # lists available disks and their partitions, modeled on macOS 'diskutil list'
    # usage: diskutil list [disk]

    local DISKS

    if [[ -n $1 ]]; then
        DISKS=$(media_device_name $1)
    else
        DISKS=$(media_real_disks)
    fi

    local DISK
    local DEV
    local TRANS
    local LOCATION
    local IDX
    local NAME
    local TYPE
    local SIZE
    local PT
    local FSTYPE
    local LABEL

    for DISK in $DISKS; do
        DEV=$(media_device_fullname "$DISK")
        TRANS=$(lsblk -dn -o TRAN "$DEV" 2>/dev/null | xargs)
        case $TRANS in
            usb|sd|thunderbolt)   LOCATION=external ;;
            *)                   LOCATION=internal ;;
        esac

        echo
        echo "$DEV ($LOCATION, physical):"
        printf '%4s  %-24s %-24s %-9s %s\n' "#:" "TYPE" "NAME" "SIZE" "IDENTIFIER"

        IDX=0
        # -l (list format) avoids the '-d', '├─' tree prefixes, so no sed is needed.
        lsblk -l -n -o NAME,TYPE,SIZE,PTTYPE,FSTYPE,LABEL "$DEV" 2>/dev/null |
        while read -r NAME TYPE SIZE PT FSTYPE LABEL; do
            IDX=$((IDX+1))

            # '512M' -> '512 MB' style
            if [[ $SIZE =~ ^([0-9.]+)([KMGT]?)$ ]]; then
                case ${BASH_REMATCH[2]} in
                    K) SIZE="${BASH_REMATCH[1]} KB" ;;
                    M) SIZE="${BASH_REMATCH[1]} MB" ;;
                    G) SIZE="${BASH_REMATCH[1]} GB" ;;
                    T) SIZE="${BASH_REMATCH[1]} TB" ;;
                    *) SIZE=${BASH_REMATCH[1]} ;;
                esac
            fi

            if [[ $TYPE == disk ]]; then
                # whole disk: show the partition scheme like macOS (MBR / GUID)
                case $PT in
                    dos|msdos) PT=MBR_partition_scheme ;;
                    gpt)       PT=GUID_partition_scheme ;;
                    *)         PT="$PT" ;;
                esac
                printf '%4s  %-24s %-24s %-9s %s\n' $IDX "$PT" "" "$SIZE" "/dev/$NAME"
            else
                printf '%4s  %-24s %-24s %-9s %s\n' $IDX "$FSTYPE" "$LABEL" "$SIZE" "/dev/$NAME"
            fi
        done
    done
}


media_disk_align(){
    # returns an aligned byte number
    # eg: media_disk_align sda 2345433 roundup
    local DISK=$(media_device_fullname $1)
    local END_BYTE=$2
    local ROUND=$3
    local BLOCK_SIZE=$(media_disk_blocksize $DISK)

    if [[ ! $(is_number $BLOCK_SIZE) = true ]]; then
        echo_debug $LINENO blocksize not a number
        return 1
    fi

#echo_debug $LINENO starting align $END_BYTE
    if [[ ! $(is_number $END_BYTE) = true ]]; then
#echo_debug $LINENO not a number
        echo $END_BYTE
        return
    fi

    #check if END is past device size
    if [[ $END_BYTE -gt $(media_device_size $DISK) ]]; then
        echo_debug $LINENO limiting size to end of disk
        echo "100%"
       # END_BYTE=$(media_device_size $DISK)
        return
    fi

    if [[ $ROUND == "roundup" ]]; then
        END_BYTE=$(( $END_BYTE + $BLOCK_SIZE ))
    fi

    # truncate to closest smaller BLOCK_SIZE
    END_BYTE=$(( $END_BYTE / $BLOCK_SIZE * $BLOCK_SIZE ))

    echo $END_BYTE
}


media_disk_first_available_byte(){
    # returns the first available byte on disk, aligned to the block size

    local DISK=$(media_device_fullname $1)
    local LAST_PART_NUM=$(media_disk_partcount $DISK)
    local BEG
    local BEG_UNALIGNED
    local BLOCK_SIZE=$(media_disk_blocksize $DISK)
    local LAST_USED_BYTE

    media_device_checktarget $DISK disk
    if (( $? )); then echo_debug $LINENO ; return 1; fi

    if [[ ! $(is_number $BLOCK_SIZE) = true ]]; then
        echo_debug $LINENO "blocksize not a number: '$BLOCK_SIZE'"
        return 1
    fi


    # set BEG
    if [[ $LAST_PART_NUM -gt 0 ]]; then   # there are some partitions present
        # display the partition table, and get the last used byte.
        LAST_USED_BYTE=$(sudo parted $DISK -m unit B print | tail -n 1 | cut -d: -f3 | tr -d 'B')
        if [[ ! $(is_number $LAST_USED_BYTE) = true ]]; then
            echo_debug $LINENO "parted: invalid last-used-byte '$LAST_USED_BYTE'"
            return 1
        fi
        BEG_UNALIGNED=$(( $LAST_USED_BYTE + 1 ))

        # align with Block_size (round up to next block boundary)
        BEG=$(( ( $BEG_UNALIGNED + $BLOCK_SIZE - 1 ) / $BLOCK_SIZE * $BLOCK_SIZE ))

        if [[ $BEG_UNALIGNED -ne $BEG ]]; then
            echo_debug Beginning religned from $BEG_UNALIGNED to $BEG
        fi

    else
        # no partitions: leave a 1M gap for MBR/partition records
        BEG=$(( 1024 * 1024 ))
    fi

    echo $BEG
}

