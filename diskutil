is_number(){
    # validates that the argument is an integer (optionally leading '-').
    # echoes 'true' (returns 0) when it is a number, 'false' (returns 1) otherwise.
    # decimals and values like '+5' are not treated as numbers.
    local NUM=${1:-}

    # trim spaces from NUM (pure bash; avoids echo flag-parsing edge cases)
    NUM=${NUM// /}

    case ${NUM#-} in
    ''|*[!0-9]*)
            echo false
            return 1
            ;;
        *)
            echo true
            return 0
            ;;
    esac
}


info_validate_num(){
    local VAR=$1
    local NUM=$2
    local MIN=$3
    local MAX=$4


    if ! is_number "$NUM" > /dev/null; then
        ((ERRORS++))
        ui_msg_error $LINENO "Variable '$VAR' '$NUM' not a number"
        return 1
    fi


    if (( $MIN )); then
        if [ "$NUM" -lt "$MIN" ]; then
            ((ERRORS++))
            ui_msg_error $LINENO "Variable '$VAR' '$NUM' ($(bytes $NUM)) too small (min '$MIN' max '$MAX')"
        fi
    fi


    if (( $MAX )); then
        if [ "$NUM" -gt "$MAX" ]; then
            ((ERRORS++))
            ui_msg_error $LINENO "Variable '$VAR' '$NUM' too big"
        fi
    fi
}


bytes(){
    # converts between bytes and human readable sizes (pure bash, no bc)
    #   bytes 512K -b    -> 524288
    #   bytes 1048576    -> 1mb        (default direction is -h)
    #   bytes 64M        -> 64M        (-h with a suffix passes input through)
    # input: optional '-', digits, optional decimal fraction,
    #        optional K/M/G/T suffix (optionally with a b), any case.
    # returns 1 with no output on empty/invalid input.
    local RAW=${1:-}
    local TO=${2:--h}
    local NEG="" INT FRAC SUFFIX DENOM NUMER N
    local HUMAN UNIT FRACTION LTR

    RAW=${RAW// /}
    if [[ ! $RAW =~ ^(-?)([0-9]+)(\.([0-9]+))?([KkMmGgTt]([Bb])?|[Bb])?$ ]]; then
        return 1
    fi

    [[ ${BASH_REMATCH[1]} = - ]] && NEG=-
    INT=${BASH_REMATCH[2]}
    FRAC=${BASH_REMATCH[4]:-}
    SUFFIX=${BASH_REMATCH[5]}

    # no translation needed: -h with a suffix passes input through
    if [[ $TO = "-h" && -n $SUFFIX ]]; then
        echo "$RAW"
        return 0
    fi

    # exact value in units = (INT*10^d + FRAC) / 10^d, kept as a rational
    # (10# forces base 10 so leading zeros are not read as octal)
    NUMER=$(( 10#$INT ))
    DENOM=1
    if [[ -n $FRAC ]]; then
        DENOM=$(( 10 ** ${#FRAC} ))
        NUMER=$(( NUMER * DENOM + 10#$FRAC ))
    fi

    # normalize suffix ('tb' -> 'T'); unknown suffix with -b is an error
    SUFFIX=${SUFFIX^^}
    SUFFIX=${SUFFIX%B}
    case $SUFFIX in
        K)      UNIT=1024 ;;
        M)      UNIT=$(( 1024 * 1024 )) ;;
        G)      UNIT=$(( 1024 * 1024 * 1024 )) ;;
        T)      UNIT=$(( 1024 * 1024 * 1024 * 1024 )) ;;
        *)      UNIT=1 ;;
    esac

    if [[ $TO = "-b" ]]; then  # translate to bytes
        echo "$NEG$(( NUMER * UNIT / DENOM ))"
        return 0
    fi

    # translate to human readable (kb/mb/gb/tb, 2 decimals when there is a
    # remainder; raw number below 1000)
    N=$(( NUMER / DENOM ))
    if (( N < 1000 )); then
        echo "$NEG$N"
        return 0
    fi

    if   (( N >= 1024**4 )); then HUMAN=$(( N / 1024**4 )); UNIT=$(( 1024**4 )); LTR=tb
    elif (( N >= 1024**3 )); then HUMAN=$(( N / 1024**3 )); UNIT=$(( 1024**3 )); LTR=gb
    elif (( N >= 1024**2 )); then HUMAN=$(( N / 1024**2 )); UNIT=$(( 1024**2 )); LTR=mb
    else                          HUMAN=$(( N / 1024   )); UNIT=1024;   LTR=kb
    fi

    if (( N % UNIT == 0 )); then
        echo "$NEG$HUMAN$LTR"
    else
        FRACTION=$(( (N % UNIT) * 100 / UNIT ))
        echo "$NEG$HUMAN.$(printf %02d "$FRACTION")$LTR"
    fi
    return 0
}



########################################################################
# UI functions
########################################################################

ui_countdown(){
    local SECONDS=${1:-10}
    local TITLE="${2:-Countdown}"
    #local MESSAGE="${3:-Counting down...}"
    local MESSAGE=${3:-"Pausing for $SECONDS seconds... Press y to continue immediately or any other key to stop"}

    if [[ $INTERFACE = cli ]]; then
        do_countdown $SECONDS "$MESSAGE"
        if (( $? )); then
            #ui_msg  "Countdown stopped."  "" "" "" log
            return 1
        fi
    else
        whiptail_countdown "$SECONDS" "$TITLE" "$MESSAGE"
    fi
}


ui_echo(){
    # used to notify on the terminal what is going on.  optionally log it.
    # ui_echo "msg" red log
    MSG="$1"
    COLOR="${2:-grey}"
    local LOGIT="${3:-log}"   # or nolog

    if [[ $LOGIT = log ]]; then
        ui_log "$MSG"
    fi

    case $COLOR in
        red)        echo_red "$MSG" > /dev/stderr;;
        white)      echo_white "$MSG" > /dev/stderr;;
        blue)       echo_blue "$MSG" > /dev/stderr;;
        green)      echo_green "$MSG" > /dev/stderr;;
        *)          echo -e "$MSG" > /dev/stderr;;
    esac
}


ui_log(){
    # usage ui_log "message"
    local INFO=$*

    INFO=$(echo "$INFO" | sed 's/\\n/ -/g')  #change newline for ~

    if [[ ! -d $(dirname $LOG_FILE) ]]; then
        mkdir -p $(dirname $LOG_FILE)
    fi

    if [[ $LOG = on ]]; then
        touch $LOG_FILE
        echo "$(date "+%Y-%m-%d %H:%M") $INFO" >> $LOG_FILE
    fi
}


ui_msg() {
    #general message function.  Supports CLI whiptail and logging.
    # usage ui_msg INSTALL "$MSG" white OK log
    local TITLE="$1"
    local MSG="${2:-no message}"
    local COLOR="${3:-grey}"
   # OK_BUTTON="${4:-Back}"
    local OK_BUTTON="${4:-OK}"
    local LOGIT="${5:-no}"   # or log

    if [[ $LOGIT = log ]]; then
        ui_log "$MSG"
    fi

    if [[ $INTERFACE = cli ]]; then
        ui_echo "$TITLE: $MSG" $COLOR nolog
    else
        whiptail --backtitle "$BACKTITLE" --title "$TITLE" --scrolltext --ok-button "$OK_BUTTON" --msgbox "$MSG" $WT_HEIGHT_TALL  $WT_WIDTH_WIDE
    fi
}


ui_msg_error() {
    # usage:  ui_msg_error $LINENO "message"
    local LINE=$1
    shift
    do_beep_down
    local MSG="$*"
    ui_msg "$PRODUCTNAME" "ERROR in line $LINE. $MSG" red "" log
}


ui_msg_warning(){
    # usage:  ui_msg_warning $LINENO "message"
    local LINE=$1
    shift
    do_beep
    do_beep
    local MSG="$*"
    ui_msg "WARNING" "~ $MSG" red "" nolog
}


ui_yesno(){
    # returns y or n  (1 or 0)
    # general yes/no function.  Supports CLI and whiptail.
    # note, this output is often assigned to a variable, so send any additional echo statements to > /dev/stderr.
    local TITLE="$1"
    local MSG="$2"
    local DEFAULT="$3"   # defaults to Yes.  can specify --defaultno
    local yn
   # COLOR="${4:-white}"  color does not work with the 'read' command


    if [[ $INTERFACE = cli ]]; then
        case $DEFAULT in
        -y)         echo 1 ;;
        -n)         echo 0 ;;
        *)
            do_beep
            MSG="$PRODUCTNAME: $TITLE: $MSG  [y/n]?"
            # change 'newline' chars to ' -'
            MSG=$(echo "$MSG" | sed 's/\\n/ -/g')
            while true; do
                read -s -n1 -p "$MSG" yn
                case $yn in
                    [Yy]* )
                        echo 1
                        echo > /dev/stderr
                        return
                        ;;
                    [Nn]* )
                        echo 0
                        echo > /dev/stderr
                        return
                        ;;
                    * )     ;;
                esac
            done
            ;;
        esac


    else
        #translate DEFAULT for whiptail
        if [[ $DEFAULT = -n ]]; then
            DEFAULT=--defaultno
        fi
        if [[ $DEFAULT = -y ]]; then
            DEFAULT=""
        fi
        whiptail --backtitle "$BACKTITLE"  --title "$TITLE" $DEFAULT --yesno "$MSG" $WT_MB_HEIGHT $WT_MB_WIDTH 3>&1 1>&2 2>&3
        local RC=$?
        if (( $RC )); then
            echo 0   # no
        else
            echo 1   # yes
        fi
        return $RC
    fi
}



