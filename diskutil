media_partition_fs_type(){
    # returns the filesystem type from a volume (with fallback)

echo_debug "$LINENO RUNNING GET FS_TYPE ====================== ...    "

    local PARTITION=$(media_device_fullname $1)
    local DISK=$(media_device_name $1)
    local PARTNUM=$(media_device_partnum $1)
    local FS_TYPE

    # get FS_TYPE from parted
    FS_TYPE=$(sudo parted $DISK -m -s print | grep ^$PARTNUM: | cut -d: -f5 | tr -d ' ')

    if [[ -z $FS_TYPE ]]; then
        echo_debug $LINENO Retrying to get fs_type .
        sleep .5
        FS_TYPE=$(sudo parted $DISK -m -s print | grep ^$PARTNUM: | cut -d: -f5 | tr -d ' ')
    fi

    # if parted returned nothing... use lsblk
    if [[ -z $FS_TYPE ]]; then
        echo_debug $LINENO Retrying to get fs_type ..
        sleep .25
        FS_TYPE=$(lsblk -n $PARTITION -o FSTYPE)
    fi

    if [[ -z $FS_TYPE ]]; then
        echo_debug $LINENO Retrying to get fs_type ...
        sleep .5
        FS_TYPE=$(lsblk -n $PARTITION -o FSTYPE)
    fi

    if [[ -z $FS_TYPE ]]; then
        echo_debug $LINENO Retrying to get fs_type ....
        sleep .5
        FS_TYPE=$(lsblk -n $PARTITION -o FSTYPE)
    fi

    echo $FS_TYPE

    if [[ -z $FS_TYPE ]]; then
        ui_msg_error $LINENO "$LINENO Failed to get fs_type ..."
        return 1
    fi
}


