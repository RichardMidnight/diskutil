media_device_fullname(){
    # returns devicename with /dev/ added if needed
    local DEVICE=$1

    if [ -z $DEVICE ]; then
        echo_debug $LINENO No device specified.
        return 1
    fi

    # add /dev/ if missing
    if [[ ${DEVICE:0:5} != "/dev/" ]]; then    # "Device prefix not specified.  Adding '/dev/'"
        echo "/dev/$DEVICE"
    else
        echo "$DEVICE"
    fi
}


media_device_partname(){
    # returns the partition name if present.  Same as returns the last digits in the string including p if needed.
    local PARTNUM=$(echo $1 | sed 's/.*[^0-9]\(.*\)$/\1/')

    if [ -z "$(echo $1 | grep p)" ] ;then
        echo $PARTNUM
    else
        echo p$PARTNUM
    fi
}


media_device_partnum(){
    # returns the partition number if present.  Same as returns the last digits in the string.
    #echo $1 | sed 's/.*[^1-9]\(.*\)$/\1/'
    #  added the 0 to allow for partition # 10

  #  local PARTNUM=$(echo $1 | sed 's/.*[^1-9]\(.*\)$/\1/')
    local PARTNUM=$(echo $1 | sed 's/.*[^0-9]\(.*\)$/\1/')

    if [[ $(is_number "$PARTNUM") != true ]]; then
        echo_debug "$LINENO '$PARTNUM' not a number"
        return 1
    fi

    echo $PARTNUM
}


media_device_size(){     # rename to DISK_SIZE ??
    # returns the size of the device in bytes
    local DISK=$(media_device_name $1)
    #sudo parted -ms "$DEVICE" unit B print | grep $DEVICE | cut -d ':' -f 2 | tr -d 'B'

    lsblk $DISK -b -n -d -o size
}


media_device_type(){
    # returns disk or part
    local DEVICE=$(media_device_fullname $1)
    local DEVICE_TYPE=$(lsblk $DEVICE -n -d -o TYPE)

    if [[ -z $DEVICE_TYPE ]]; then
        echo_debug $LINENO Retrying device_type ...
        sleep .5
        DEVICE_TYPE=$(lsblk $DEVICE -n -d -o TYPE)
    fi

    echo $DEVICE_TYPE
}


media_device_name(){
    # returns a clean devicename with /dev/ added and partition number removed

    if [[ -z $1 ]]; then
        return
    fi

    local DEVICE=$(media_device_fullname "$1")

    # loop/nvme/mmcblk encode partitions as a trailing 'p<number>'
    # (e.g. loop7p1, nvme0n1p3, mmcblk0p2). Their base names contain
    # required digits, so strip ONLY the structured 'p<n>' suffix.
    if [[ $DEVICE == *loop* || $DEVICE == *nvme* || $DEVICE == *mmcblk* ]]; then
        echo "$DEVICE" | sed -E 's/(loop[0-9]+|nvme[0-9]+n[0-9]+|mmcblk[0-9]+)p[0-9]+$/\1/'
    else
        # sd/vd/hd-style: partition is trailing digits (sda10 -> sda)
        echo "$DEVICE" | sed 's/[0-9]*$//'
    fi
}


media_disk_friendlyname(){
    # returns a disk name based on mfg, model, size

 #echo_debug $LINENO $1 $(media_disk_model $1)
   # echo "$1: [$(media_disk_model $1) - $(bytes $(media_device_size $1) -h)]"
    echo "$1: [$(bytes $(media_device_size $1) -h) $(media_disk_model $1) ]"

}


media_disk_pt_type(){
    # returns the partition table type
    # parted says msdos.  lsblk says dos

    local DISK=$(media_device_name $1)

    #local PT_TYPE=$(lsblk $DISK -n -d -o PTTYPE)

    #if [[ -z $PT_TYPE ]]; then
        PT_TYPE=$(sudo parted -m $DISK print | grep $DISK | cut -d: -f6)
    #fi

    echo $PT_TYPE
}


media_device_checktarget(){
    # confirms that a device exists, is not root, and is of proper type

    local DEVICE=$(media_device_fullname "$1")
    local TYPE=$2    # disk or part or blank

#echo_debug $LINENO  $DEVICE $TYPE

    if [[ -z $DEVICE ]]; then
        ui_msg_error $LINENO "Target '$DEVICE' is blank"
        return 1
    fi

    local PART_COUNT=$(media_disk_partcount "$DEVICE")

    if [[ ! -e $DEVICE ]]; then   # pause and try again
        sleep .5
        if [[ ! -e $DEVICE ]]; then
            ui_msg_error $LINENO "Device '$DEVICE' does not exist"
            return 1
        fi
    fi

#echo_debug $LINENO $DEVICE $TYPE   $(media_device_type $DEVICE) $PART_COUNT


	#if it is a miss-match and not a disk with no partitions
    local DEVICE_TYPE=$(media_device_type $DEVICE)
    if [[ -z $DEVICE_TYPE ]]; then
        echo "Retrying to get Device_Type ($LINENO) ..."
        sleep .25
        local DEVICE_TYPE=$(media_device_type $DEVICE)
    fi

    if [[ $DEVICE_TYPE != $TYPE ]] ; then
#echo_debug $LINENO
        if [[ $TYPE = part ]] && [[ $PART_COUNT -ne 0 ]]; then
            ui_msg_error $LINENO "Device '$DEVICE' '$DEVICE_TYPE' is not type '$TYPE'"
            return 1
        fi
    fi



    # Stop if dev is the root device
    if [[ $DEVICE = $(env_root_device) ]]; then
        ui_msg_error $LINENO "Device '$DEVICE' is root device"
        return 1
    fi
}


