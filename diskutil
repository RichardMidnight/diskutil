env_which () {
    # report whether a program is on PATH. Uses the bash built-in 'command -v'
    # instead of the 'which' external, so it needs no extra package and never
    # calls sudo. Returns 0 (and prints 1) when found, 1 otherwise -- callers
    # test it with [[ -z $(env_which $FILE) ]].
    local FILE=$1

    # make sure /usr/sbin is searchable without mutating the caller's PATH.
    # NOTE: must assign ($PATH) -- a bare 'local PATH' would clear PATH in bash.
    local PATH=$PATH
    case ":${PATH}:" in
        *:/usr/sbin:*) ;;
        *) PATH="$PATH:/usr/sbin" ;;
    esac

    if command -v "$FILE" 1>/dev/null 2>/dev/null; then
        echo 1
        return 0
    fi
    return 1
}


env_install_tools() {
    local TOOL
    #SILENT=${1:-"-n"}
    local INSTALL=$(env_installer)
    if [[ -z $INSTALL ]]; then
        return 1
    fi

    for TOOL in $REQUIRED_TOOLS; do

    if [[ -z $(env_which $TOOL) ]] ; then
        # $INSTALL is a multi-word command string from env_installer (e.g. "apt install -y");
        # it must word-split into program + flags. Intentionally unquoted (do not quote).
        # shellcheck disable=SC2086
        case $TOOL in

        udisksctl)
            sudo $INSTALL udisks2 -y
            ;;

        dd)
            # 'dd' is part of coreutils; there is no standalone 'dd' package
            sudo $INSTALL coreutils -y
            ;;

        *)
            #echo_white Installing $TOOL ...
            ui_echo "Installing $TOOL..." white
            sudo $INSTALL $TOOL
            if (( $? )); then
                ui_msg_warning $LINENO "$TOOL not installed."
            fi
            ;;
        esac
    fi

    done
}


env_list_filesystems(){
    # lists supported filesystems and whether support (mkfs tools) is installed
    local FILESYSTEM
    local FILE
    local INSTALLED

    echo "Supported Filesystems:"

    for FILESYSTEM in $FILESYSTEMS; do
        case $FILESYSTEM in
            fat16|fat32|vfat)   FILE="mkfs.vfat" ;;
            linux-swap|freespace)  FILE="mkswap" ;;
            hfs+)               FILE="mkfs.hfsplus" ;;
            *)                  FILE="mkfs.$FILESYSTEM" ;;
        esac

        if [[ -z $(env_which $FILE) ]]; then
            INSTALLED="Not installed"
        else
            INSTALLED="Installed"
        fi

        echo -e "$FILESYSTEM \t - "$INSTALLED
    done

}


