run_command(){
    # executes a bash command displaying it first and reporting on any errors.
    local CMD=$1
    local LINE=$2
    #local QUIET=$3
    local EC
    local OUTPUT

    local YESNO
    local VERBOSE
    getargs $*

    if [[ $VERBOSE != -v ]]; then
        #OUTPUT=" > /dev/stderr"
        OUTPUT=" 1> /dev/null"
    fi

    echo -n "$PRODUCTNAME: running: "
    ui_echo "$CMD" blue
    # Intentional: eval re-parses $CMD and $OUTPUT (e.g. a redirection like "1> /dev/null").
    # Quoting would change how it expands; leave unquoted.
    # shellcheck disable=SC2086
    eval $CMD $OUTPUT
    EC=$?
    if (( $EC )); then
        ui_msg_error "$LINENO $LINE" "Exit_code $EC running '$CMD'"
        #ui_echo "~ Exit_code $RC running '$CMD'" red log
        return $EC
    fi
}


env_installer(){
    # Note: returns a MULTI-WORD command (e.g. "apt install -y") that is intended
    # to word-split at the call site. Do NOT quote these call sites (sudo $INSTALL ...)
    # -- quoting would treat the whole string as one program name and break.
    local INSTALLER=

    if [ -f /usr/bin/apt ]; then             # debian
        INSTALLER="apt install -y"
    elif [ -f /usr/bin/pacman ]; then        # arch
        INSTALLER="pacman -S --noconfirm"
    elif [ -f /usr/bin/dnf ]; then            #rpm / fedora
        INSTALLER="dnf install -y"
    elif [ -f /usr/bin/zypper ]; then         # opensuse
        INSTALLER="zypper install -y"
    elif [ -f /usr/bin/xbps-install ]; then   # void
        INSTALLER="xbps-install -S -y"
    fi

    if [ -z "$INSTALLER" ]; then
        ui_msg_error "${1:-0}" "No supported package manager found (apt/pacman/dnf/zypper/xbps)."
        return 1
    fi

    echo "$INSTALLER"
}


env_removal(){
    # returns the package removal command for this distro
    # Note: returns a MULTI-WORD command (e.g. "apt remove -y") intended to word-split
    # at the call site. Do NOT quote the call sites (sudo $REMOVE ...) -- same as
    # env_installer above.
    local REMOVER=

    if [ -f /usr/bin/apt ]; then             # debian
        REMOVER="apt remove -y"
    elif [ -f /usr/bin/pacman ]; then        # arch
        REMOVER="pacman -Rns"
    elif [ -f /usr/bin/dnf ]; then            #rpm / fedora
        REMOVER="dnf remove -y"
    elif [ -f /usr/bin/zypper ]; then         # opensuse
        REMOVER="zypper rm -y"
    elif [ -f /usr/bin/xbps-install ]; then   # void
        REMOVER="xbps-install -R"
    fi

    if [ -z "$REMOVER" ]; then
        ui_msg_error "${1:-0}" "No supported package manager found (apt/pacman/dnf/zypper/xbps)."
        return 1
    fi

    echo "$REMOVER"
}


env_package_in_use(){
    # returns true (0) if an installed package depends on the given package,
    # or if the package is marked Essential by the distro

    local PKG=$1

    if [ -f /usr/bin/apt ]; then
        local SIM=$(apt-get -s remove "$PKG" 2>/dev/null)
        # apt itself flags Essential removals
        if echo "$SIM" | grep -q "essential packages will be removed"; then
            return 0
        fi
        # other installed packages would be removed in the chain -> in use
        local OTHERS=$(echo "$SIM" | awk '/will be REMOVED:/{f=1;next} f && /^ [^ ]/{print} f && !/^ /{exit}' | tr ' ' '\n' | grep -v "^$PKG$" | tr '\n' ' ')
        if [[ -n $OTHERS ]]; then
            return 0
        fi
    else
        # No supported manager to safely evaluate the removal. Fail safe:
        # treat as "in use" so callers block the (destructive) removal.
        return 0
    fi

    return 1
}


